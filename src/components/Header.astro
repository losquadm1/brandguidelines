---

---
<div class="header">
    <h1><img src="/image/logo.png" alt="Netflix"/>Annual Report</h1>
</div>

<div class="toc">
    <details class="toc-panel">
        <summary>Table of Contents</summary>
        <nav aria-label="Table of contents">
            <ul class="toc-list"></ul>
        </nav>
    </details>
</div>

<script>
    const tocList = document.querySelector('.toc-list');
    const headings = Array.from(document.querySelectorAll('h1'));

    const slugify = (value: string) =>
        value
            .toLowerCase()
            .replace(/&/g, 'and')
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');

    const usedIds = new Set(
        headings
            .map((heading) => heading.id)
            .filter(Boolean)
    );

    const getUniqueId = (baseValue: string) => {
        const baseId = baseValue || 'section';
        if (!usedIds.has(baseId)) {
            usedIds.add(baseId);
            return baseId;
        }

        let suffix = 2;
        while (usedIds.has(`${baseId}-${suffix}`)) {
            suffix += 1;
        }

        const nextId = `${baseId}-${suffix}`;
        usedIds.add(nextId);
        return nextId;
    };

    headings.forEach((heading) => {
        const label = heading.textContent?.replace(/\s+/g, ' ').trim();
        if (!label || !tocList) {
            return;
        }

        if (!heading.id) {
            heading.id = getUniqueId(slugify(label));
        }

        const item = document.createElement('li');
        item.className = `toc-item toc-${heading.tagName.toLowerCase()}`;

        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = label;

        item.appendChild(link);
        tocList.appendChild(item);
    });

    const tocDetails = document.querySelector('.toc-panel') as HTMLDetailsElement | null;
    const tocSummary = tocDetails?.querySelector('summary');
    let keyboardNavigationActive = false;

    window.addEventListener('keydown', () => {
        keyboardNavigationActive = true;
    });

    window.addEventListener('pointerdown', () => {
        keyboardNavigationActive = false;
    });

    if (tocDetails && tocSummary) {
        tocSummary.addEventListener('focus', () => {
            if (keyboardNavigationActive) {
                tocDetails.open = true;
            }
        });
    }
</script>

<style>
@font-face {
    font-family: "Netflix Sans";
    src: url("/Netflix%20Sans%20Medium.otf") format("opentype");
    font-weight: 500;
    font-style: normal;
}

.header {
display: flex;
align-content: center;
justify-content: center;
background-color: black;
padding: 100px 20px;
border-bottom: 2px solid var(--color-accent);
text-align: center;
}

h1 {
    border: none;
    font-size: clamp(2.1rem, 9vw, 100px);
}

.toc {
    display: flex;
    position: sticky;
    top: 0;
    z-index: 10;
    justify-content: center;
    background-color: black;
    width: 100%;
    border-bottom: 2px solid var(--color-accent);
}

.toc-panel {
    width: min(420px, calc(100vw - 48px));
    border:none;
    background: rgba(0, 0, 0, 0.94);
    color: #fff;
    overflow: hidden;
    font-family: "Netflix Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.toc-panel summary {
    cursor: pointer;
    list-style: none;
    padding: 16px 20px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    font-family: "Netflix Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    position: relative;
}

.toc-panel summary:focus-visible,
.toc-item a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
}

.toc-panel summary::-webkit-details-marker {
    display: none;
}

.toc-panel summary::after {
    content: ">";
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    transition: transform 0.4s ease;
    margin-right: 69px;
}

@media (max-width: 430px) {
    .toc-panel summary::after {
        margin-right: 0px;
    }
}

.toc-panel[open] summary::after {
    transform: translateY(-50%) rotate(90deg);
}

.toc-panel nav {
    overflow: auto;
    padding: 10px 0;
}

.toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
}

.toc-item a {
    display: block;
    padding: 8px 20px;
    color: #fff;
    text-decoration: none;
    line-height: 1.35;
}

.toc-item a:hover {
    color: #d3d3d3;
    background: rgba(255, 255, 255, 0.08);
}

.toc-item a:visited {
    color: #fff;
}

.toc-h2 a {
    font-size: 0.96rem;
}

</style>