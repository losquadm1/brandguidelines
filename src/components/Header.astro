---

---
<div class="header">
    <h1><img src="/image/logo.png" alt="Netflix"/>Anual Report</h1>
</div>

<div class="toc">
    <details class="toc-panel">
        <summary>Table of Contents</summary>
        <nav aria-label="Table of contents">
            <ul class="toc-list"></ul>
        </nav>
    </details>
</div>

<script>
    const tocList = document.querySelector('.toc-list');
    const headings = Array.from(document.querySelectorAll('h1, h2'));

    const slugify = (value) =>
        value
            .toLowerCase()
            .replace(/&/g, 'and')
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');

    const usedIds = new Set(
        headings
            .map((heading) => heading.id)
            .filter(Boolean)
    );

    const getUniqueId = (baseValue) => {
        const baseId = baseValue || 'section';
        if (!usedIds.has(baseId)) {
            usedIds.add(baseId);
            return baseId;
        }

        let suffix = 2;
        while (usedIds.has(`${baseId}-${suffix}`)) {
            suffix += 1;
        }

        const nextId = `${baseId}-${suffix}`;
        usedIds.add(nextId);
        return nextId;
    };

    headings.forEach((heading) => {
        const label = heading.textContent?.replace(/\s+/g, ' ').trim();
        if (!label || !tocList) {
            return;
        }

        if (!heading.id) {
            heading.id = getUniqueId(slugify(label));
        }

        const item = document.createElement('li');
        item.className = `toc-item toc-${heading.tagName.toLowerCase()}`;

        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = label;

        item.appendChild(link);
        tocList.appendChild(item);
    });
</script>

<style>
.header {
display: flex;
align-content: center;
justify-content: center;
background-color: black;
padding: 100px 0px;
border-bottom: 2px solid var(--color-accent);
text-align: center;
}

h1 {
    border: none;
    font-size: 100px;
}

.toc {
    position: sticky;
    top: 16px;
    z-index: 10;
    margin: 16px 24px 0;
    display: flex;
    justify-content: flex-end;
}

.toc-panel {
    width: min(420px, calc(100vw - 48px));
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 18px;
    background: rgba(12, 12, 12, 0.94);
    color: #fff;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
    overflow: hidden;
}

.toc-panel summary {
    cursor: pointer;
    list-style: none;
    padding: 16px 20px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.toc-panel summary::-webkit-details-marker {
    display: none;
}

.toc-panel nav {
    max-height: 55vh;
    overflow: auto;
    padding: 10px 0;
}

.toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
}

.toc-item a {
    display: block;
    padding: 8px 20px;
    color: #f5f5f5;
    text-decoration: none;
    line-height: 1.35;
}

.toc-item a:hover {
    background: rgba(255, 255, 255, 0.08);
}

.toc-h1 a {
    font-weight: 700;
}

.toc-h2 a {
    padding-left: 34px;
    font-size: 0.96rem;
}

</style>