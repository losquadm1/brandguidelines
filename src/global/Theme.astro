---
// we can import fonts here, after installing them via Fontsource
// see https://fontsource.org/docs/installation for instructions
import "@fontsource/karla";
---

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Bebas+Neue&family=Caladea:ital,wght@0,400;0,700;1,400;1,700&family=Calistoga&family=Play:wght@400;700&family=Stalinist+One&display=swap');

@font-face {
  font-family: "NetflixSans";
  src:
    local("Netflix Sans Medium"),
    url("/Netflix Sans Medium.otf") format("otf");
}
  /* We can use this style tag to set up colors, fonts, etc. */
  :root {
    --color-background: #090909;
    --color-text: rgb(240, 240, 240);
    --color-accent: #B81D24;
    --color-focus-ring: rgb(255, 255, 255);
    --color-link: #ffffff;
    --color-link-hover: #d3d3d3;
    --color-link-visited: #ffffff;

    --font-body: "NetflixSans", sans-serif;
    --font-headings: "Bebas Neue", sans-serif;

    font-size: 17px;

    /* These sizes are used by the Container component to set up the page container */
    --size-page-width: 850px;
    --size-page-padding: 1rem;
  }

  /* We can also apply these colors as a default */
  body {
    background-color: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-body);
    max-width: 100%;
    overflow-x: hidden;
  }

  main {
    max-width: 100%;
    overflow-x: hidden;
  }
 
  h2,
  
  h4,
  h5,
  h6 {
  font-family: var(--font-body);
    color: var(--color-text);
    padding: 20px 0px 0px 0px
  }

  h1{
  font-family: var(--font-headings);
    color: var(--color-accent);
    font-size: 60px;
    border-bottom: 1px solid var(--color-accent);
  }

  h3{
      font-family: var(--font-body);
    color: var(--color-text);
    font-size: 20px;
  }
  /* default focus ring styles */
  *:focus-visible {
    outline: 3px solid var(--color-focus-ring);
  }

  p{
    line-height: 1.55;
    padding-top: 10px;
    padding-bottom: 5px;
  }

  a {
    color: var(--color-link);
  }

  a:hover {
    color: var(--color-link-hover);
  }

  a:visited {
    color: var(--color-link-visited);
  }

  table {
    border-collapse: collapse;
    border: none !important;
    width: 100%;
  }

  table tr {
    border: none !important;
  }

  table tr:nth-child(even) {
    background-color: rgba(112, 0, 0, 0.65) !important;
  }

  table tr:nth-child(odd) {
    background-color: #090909 !important;
  }

  table td,
  table th {
    border: none !important;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 1024px) {
    :root {
      font-size: 15px;
      --size-page-padding: 0.75rem;
    }

    h1 {
      font-size: clamp(2rem, 8vw, 3.25rem);
    }

    h2 {
      font-size: clamp(1.3rem, 5.5vw, 2rem);
    }

    h3 {
      font-size: clamp(1.05rem, 4.5vw, 1.25rem);
    }

    table {
      display: block;
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    table[style],
    td[style],
    th[style] {
      max-width: 100% !important;
    }

    table td[style],
    table th[style] {
      width: auto !important;
      min-width: 0 !important;
      max-width: none !important;
    }

    table p[style*="padding-left"] {
      padding-left: 0 !important;
      text-align: center !important;
    }

    table [style*="padding-left: 373.64px"] {
      padding-left: 0 !important;
    }

    table td p,
    table th p {
      font-size: clamp(10px, 2.6vw, 13px) !important;
      padding: 4px !important;
      line-height: 1.3;
      word-break: break-word;
      overflow-wrap: anywhere;
    }

    span[style*="width:"],
    span[style*="height:"] {
      width: 100% !important;
      max-width: 100% !important;
      height: auto !important;
      display: block !important;
    }

    img[style*="width:"] {
      width: 100% !important;
      max-width: 100% !important;
      height: auto !important;
    }

    p,
    li {
      overflow-wrap: anywhere;
      word-break: break-word;
    }
  }
</style>
